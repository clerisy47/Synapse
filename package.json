{
  "name": "synapse-cli",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone terminal Markdown workspace assistant",
  "main": "dist/cli/main.js",
  "scripts": {
    "build": "node scripts/build-cli.mjs",
    "dev": "tsc -p cli/tsconfig.json --watch",
    "typecheck": "tsc -p cli/tsconfig.json --noEmit",
    "lint": "node scripts/check-cli.mjs",
    "boundaries": "node scripts/check-cli.mjs",
    "check:network": "node scripts/check-cli.mjs",
    "check:writes": "node scripts/check-cli.mjs",
    "check:schema": "node scripts/check-cli.mjs",
    "test": "npm run build && node --test test/cli/scaffold.test.mjs test/cli/corpus.test.mjs",
    "test:release": "npm run build && node --test test/cli/install.test.mjs"
  },
  "keywords": [
    "markdown",
    "cli"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "type": "module",
  "bin": {
    "synapse": "dist/cli/main.js"
  },
  "files": [
    "dist/cli",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  }
}
