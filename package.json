{
  "name": "vault-synapse",
  "version": "0.1.0",
  "private": true,
  "description": "Obsidian plugin: OpenRouter free-model Q&A (Phase A), then local Ollama (Phase B)",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node scripts/generate-control-starters.mjs && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src",
    "boundaries": "node scripts/check-boundaries.mjs",
    "check:network": "node scripts/check-no-network.mjs",
    "check:writes": "node scripts/check-no-writes.mjs",
    "check:schema": "node scripts/check-schema-subset.mjs",
    "test:vault": "vitest run test/integration/mini-vault.test.ts test/integration/pipeline-e2e.test.ts test/integration/recipient-pipeline.test.ts test/integration/control-ingest.test.ts test/integration/recipient-tools.test.ts test/integration/research-inbox.test.ts"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin"
  ],
  "license": "MIT",
  "peerDependencies": {
    "obsidian": "1.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "dependency-cruiser": "^16.10.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.22.0",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "happy-dom": "^21.0.1",
    "obsidian": "1.13.1",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  },
  "dependencies": {
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  }
}
